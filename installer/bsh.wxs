<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI for BSH.

  Built by scripts/ci/package-windows.ps1 with WiX Toolset v3. The install is
  per-user (LocalAppData\Programs\BOS\BSH) so it needs no elevation, and the
  Start Menu shortcut lives in the user's own menu. UpgradeCode is fixed for
  the product's lifetime; ProductCode is generated per build so a newer MSI
  replaces an older one through MajorUpgrade.

  Variables (passed with candle -d):
    ProductVersion, BinaryPath, LicensePath, ReadmePath, IconPath
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="BSH"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="BrickOS Team"
           UpgradeCode="E65D2886-D3A8-422E-AC45-35C30CACC3CB">

    <!-- The platform comes from -dPlatform, which package-windows.ps1 sets
         from -Arch: x64 on the x64 runner, arm64 on the arm64 one. -->
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="$(var.Platform)"
             Description="BSH - BOS Harness"
             Comments="Native desktop agent workspace" />

    <!-- AllowSameVersionUpgrades lets one prerelease replace another that
         shares the same numeric core (3.0.3-rc.1 -> 3.0.3-rc.2), which the MSI
         ProductVersion cannot distinguish. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of BSH is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BshIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="BshIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/open1s/bos" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="CompanyFolder" Name="BOS">
          <Directory Id="INSTALLFOLDER" Name="BSH" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="BSH" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="BshExe" Source="$(var.BinaryPath)" Name="bsh.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt" Source="$(var.LicensePath)" Name="LICENSE.txt" />
      </Component>
      <Component Id="ReadmeFile" Guid="*">
        <File Id="ReadmeMd" Source="$(var.ReadmePath)" Name="README.md" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="BshShortcut"
                  Name="BSH"
                  Description="BOS Harness"
                  Target="[INSTALLFOLDER]bsh.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\BOS\BSH"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="BSH" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
