{
  "name": "@local/dsh-echo",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "description": "Fixture DeepSeek Harness package used by the extension tests.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/*.json",
    "commands/*.md",
    "skills/*/SKILL.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": { "dsh": ">=0.2.0" }
}
