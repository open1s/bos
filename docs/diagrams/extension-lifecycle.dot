digraph ExtensionPlatform {
  graph [
    bgcolor="#FFFFFF", pad="0.42", rankdir=TB, nodesep="0.24", ranksep="0.42",
    splines=ortho, outputorder=edgesfirst, fontname="Arial",
    label="BSH Extension Platform", labelloc=t, labeljust=l,
    fontsize=28, fontcolor="#111111"
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial",
    fontsize=16, margin="0.32,0.24", color="#D9DDE2",
    fillcolor="#FFFFFF", fontcolor="#111111", penwidth=1.2
  ];
  edge [color="#111111", penwidth=1.5, arrowsize=0.75];

  subgraph cluster_platform {
    label=""; color="#D9DDE2"; penwidth=1.2; style="rounded"; margin=24;

    api [
      label=<<B>BSH Extension API</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Manifest  ·  Lifecycle  ·  Capability  ·  Contribution</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.6, height=1.0
    ];
    runtime [
      label=<<B>Runtime Abstraction Layer</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Unified extension runtime</FONT>>,
      fillcolor="#F2F2F2", color="#E8E8E8", width=8.6, height=1.0
    ];

    implementations [
      label=<<B>Extension Runtimes</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Native Rust  ·  Extism  ·  Wasmtime / WIT</FONT>>,
      width=8.6, height=1.0
    ];
    services [
      label=<<B>BSH Services</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Agent  ·  UI  ·  Events  ·  Storage  ·  Computer Use</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.6, height=1.0
    ];

    api -> runtime -> implementations -> services;
  }
}