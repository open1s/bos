digraph ExtensionLifecycle {
  graph [
    bgcolor="#0B1020", pad="0.42", rankdir=TB,
    nodesep="0.36", ranksep="0.48", splines=ortho,
    newrank=true, outputorder=edgesfirst,
    fontname="DejaVu Sans", label="BSH EXTENSION PLATFORM  /  PACKAGE LIFECYCLE",
    labelloc=t, fontsize=23, fontcolor="#F3F6FC"
  ];
  node [
    shape=box, style="rounded,filled", fontname="DejaVu Sans",
    fontsize=12, margin="0.24,0.16", color="#3B506F",
    fillcolor="#17243A", fontcolor="#F3F6FC", penwidth=1.6,
    width=3.2
  ];
  edge [color="#647A99", penwidth=1.6, arrowsize=0.75];

  package [label="01  PACKAGE\nextension.toml · files · runtime type", color="#6EA8FE"];
  validate [label="02  VALIDATE\nSchema · content · hash · compatibility", color="#55D6E8"];
  resolve [label="03  RESOLVE\nDependencies · version constraints", color="#B69CFF"];
  install [label="04  INSTALL\nStage · verify · publish managed version", color="#67D6A3"];
  activate [label="05  ACTIVATE\nStart adapter · register contributions", color="#FFBE78"];
  package -> validate -> resolve -> install -> activate;

  subgraph cluster_host {
    label="RUNTIME & HOST BOUNDARY";
    labelloc=t; labeljust=l; fontsize=12; fontcolor="#B69CFF";
    color="#59477C"; style="rounded"; penwidth=1.5; margin=18;
    adapters [label="RUNTIME ADAPTERS\nDeclarative · Process / JSON-RPC\nWASM Component · Extism · MCP · Built-in Rust", fillcolor="#121B2E", color="#536987", fontsize=11, width=5.0];
    host [label="HOST CAPABILITY BOUNDARY\nRequest → policy decision → host API\nAudit authorization decisions", fillcolor="#241C3B", color="#B69CFF", fontsize=11, width=5.0];
    adapters -> host;
  }
  activate -> adapters;

  note [
    shape=note, style="filled", label="SECURITY IS LAYERED\nCapability authorization and OS-level isolation are separate controls.\nEnforcement depends on the runtime and operating system.",
    fillcolor="#121B2E", color="#536987", fontsize=10, width=5.0
  ];
  host -> note [style=dashed, arrowhead=none, color="#536987"];
}
