digraph AgentExecution {
  graph [
    bgcolor="#FFFFFF", pad="0.42", rankdir=TB, nodesep="0.28", ranksep="0.38",
    splines=ortho, outputorder=edgesfirst, fontname="Arial",
    label="BOS Agent Execution Model", labelloc=t, labeljust=l,
    fontsize=28, fontcolor="#111111"
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial",
    fontsize=14, margin="0.28,0.20", color="#D9DDE2",
    fillcolor="#FFFFFF", fontcolor="#111111", penwidth=1.2
  ];
  edge [color="#111111", penwidth=1.4, arrowsize=0.7];

  subgraph cluster_execution {
    label=""; color="#D9DDE2"; penwidth=1.2; style="rounded"; margin=22;

    request [
      label=<<B>Agent Request</B><BR/><FONT POINT-SIZE="13" COLOR="#666666">User intent  ·  Conversation context  ·  Available capabilities</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.8, height=0.95
    ];
    understand [
      label=<<B>Understand &amp; Plan</B><BR/><FONT POINT-SIZE="13" COLOR="#666666">Interpret intent  ·  Build plan  ·  Select model and capabilities</FONT>>,
      fillcolor="#F2F2F2", color="#E8E8E8", width=8.8, height=0.95
    ];

    reason [label=<<B>Reason</B><BR/><FONT POINT-SIZE="12" COLOR="#666666">ReAct  ·  Multi-step decisions</FONT>>, width=2.65];
    coordinate [label=<<B>Coordinate</B><BR/><FONT POINT-SIZE="12" COLOR="#666666">Delegation  ·  Agent collaboration</FONT>>, width=2.65];
    execute [label=<<B>Execute</B><BR/><FONT POINT-SIZE="12" COLOR="#666666">Tools  ·  Skills  ·  MCP  ·  Extensions</FONT>>, width=2.65];

    result [
      label=<<B>Observe &amp; Adapt</B><BR/><FONT POINT-SIZE="13" COLOR="#666666">Tool results  ·  Events  ·  Context updates  ·  Next action</FONT>>,
      fillcolor="#F2F2F2", color="#E8E8E8", width=8.8, height=0.95
    ];
    response [
      label=<<B>Agent Response</B><BR/><FONT POINT-SIZE="13" COLOR="#666666">Structured output  ·  User-facing result  ·  Execution trace</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.8, height=0.95
    ];

    {rank=same; reason; coordinate; execute;}
    request -> understand;
    understand -> reason;
    understand -> coordinate;
    understand -> execute;
    reason -> result;
    coordinate -> result;
    execute -> result;
    result -> response;
  }
}