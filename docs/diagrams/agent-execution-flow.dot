digraph AgentFlow {
  graph [
    bgcolor="#0B1020", pad="0.42", rankdir=TB,
    nodesep="0.38", ranksep="0.48", splines=ortho,
    newrank=true, outputorder=edgesfirst,
    fontname="DejaVu Sans", label="AGENT EXECUTION  /  REACT LOOP",
    labelloc=t, fontsize=23, fontcolor="#F3F6FC"
  ];
  node [
    shape=box, style="rounded,filled", fontname="DejaVu Sans",
    fontsize=12, margin="0.24,0.16", color="#3B506F",
    fillcolor="#17243A", fontcolor="#F3F6FC", penwidth=1.6
  ];
  edge [color="#647A99", penwidth=1.6, arrowsize=0.75];

  input [label="01  INPUT\nUser request + session context", color="#6EA8FE", width=3.5];
  reason [label="02  REASON\nBuild context · call model · stream", color="#B69CFF", width=3.5];
  decide [shape=diamond, style="filled", label="03\nDECIDE", color="#FFBE78", fillcolor="#352B1B", width=1.7, height=0.95, margin=0.08];
  execute [label="04  EXECUTE TOOL\nResolve · authorize · invoke", color="#67D6A3", width=3.5];
  observe [label="05  OBSERVE\nCapture result · update context", color="#55D6E8", width=3.5];
  finish [label="RETURN\nFinal response + execution metadata", fillcolor="#102C31", color="#67D6A3", penwidth=2, width=3.5];

  input -> reason -> decide;
  decide -> finish [label="  final answer", color="#67D6A3", fontcolor="#67D6A3", minlen=2];
  decide -> execute [label="  tool call", color="#FFBE78", fontcolor="#FFBE78"];
  execute -> observe [color="#55D6E8"];
  observe -> reason [label="  feedback to context", color="#55D6E8", fontcolor="#55D6E8", constraint=false, minlen=2];

  guard [
    shape=box, style="rounded,filled", label="EXECUTION GUARDRAILS\nTool registry · capability policy · deadlines · cancellation\nRetry / rate limits · observability",
    fillcolor="#121B2E", color="#536987", fontsize=10, width=7.2
  ];
  {rank=same; execute; guard;}
  execute -> guard [style=dashed, arrowhead=none, color="#536987", constraint=false];
}
