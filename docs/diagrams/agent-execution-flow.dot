digraph AgentCapabilities {
 graph [bgcolor="#0B1020",pad="0.55",rankdir=TB,nodesep="0.38",ranksep="0.52",splines=none,newrank=true,outputorder=edgesfirst,fontname="DejaVu Sans",label="BOS AGENT ENGINE  /  INTELLIGENCE THAT GETS THINGS DONE",labelloc=t,fontsize=25,fontcolor="#F3F6FC"];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,margin="0.28,0.22",color="#405575",fillcolor="#17243A",fontcolor="#F3F6FC",penwidth=1.5];
 edge [style=invis,weight=30];
 hero [label="FROM NATURAL LANGUAGE TO REAL-WORLD ACTION\nUnderstand  ·  Reason  ·  Coordinate  ·  Execute  ·  Learn",fontsize=17,width=10.0,height=1.0,fillcolor="#172F46",color="#55D6E8",penwidth=2.4];
 subgraph cluster_intelligence {label="INTELLIGENCE";labelloc=t;fontsize=13;fontcolor="#B69CFF";color="#59477C";style="rounded";penwidth=1.5;margin=20;
 reasoning [label="REASONING & PLANNING\nReAct · multi-step decisions",color="#B69CFF",fillcolor="#29213E"];
 context [label="CONTEXT AWARENESS\nSessions · memory · skills",color="#6EA8FE",fillcolor="#192B48"];
 coordination [label="AGENT COORDINATION\nDelegation · collaboration",color="#55D6E8",fillcolor="#17313A"];
 {rank=same;reasoning;context;coordination;} reasoning -> context -> coordination;
 }
 subgraph cluster_execution {label="EXECUTION";labelloc=t;fontsize=13;fontcolor="#67D6A3";color="#398B7B";style="rounded";penwidth=1.5;margin=20;
 models [label="MODEL CONNECTIVITY\nProviders · streaming · fallback",color="#B69CFF"];
 tools [label="TOOL & SKILL ECOSYSTEM\nNative tools · MCP · extensions",color="#55D6E8"];
 events [label="EVENT-DRIVEN RUNTIME\nPub/Sub · query · RPC",color="#FFBE78"];
 {rank=same;models;tools;events;} models -> tools -> events;
 }
 subgraph cluster_control {label="TRUST  ·  RELIABILITY  ·  VISIBILITY";labelloc=t;fontsize=13;fontcolor="#FFBE78";color="#66543A";style="rounded";penwidth=1.5;margin=20;
 security [label="CAPABILITY GOVERNANCE\nPolicy-controlled host access",color="#FFBE78",fillcolor="#302719"];
 resilience [label="RESILIENT EXECUTION\nDeadlines · retries · limits",color="#67D6A3",fillcolor="#17352F"];
 observability [label="FULL OBSERVABILITY\nLogs · metrics · execution state",color="#6EA8FE",fillcolor="#192B48"];
 {rank=same;security;resilience;observability;} security -> resilience -> observability;
 }
 hero -> reasoning; reasoning -> models; models -> security;
}