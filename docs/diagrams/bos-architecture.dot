digraph BOS {
  graph [
    bgcolor="#FFFFFF", pad="0.42", rankdir=TB, nodesep="0.28", ranksep="0.42",
    splines=ortho, outputorder=edgesfirst, fontname="Arial",
    label="BOS Platform Architecture", labelloc=t, labeljust=l,
    fontsize=28, fontcolor="#111111"
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial",
    fontsize=16, margin="0.32,0.24", color="#D9DDE2",
    fillcolor="#FFFFFF", fontcolor="#111111", penwidth=1.2
  ];
  edge [color="#111111", penwidth=1.5, arrowsize=0.75];

  subgraph cluster_bos {
    label=""; color="#D9DDE2"; penwidth=1.2; style="rounded"; margin=24;

    interfaces [
      label=<<B>BOS Interfaces</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Rust  ·  Python  ·  JavaScript  ·  BSH</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.6, height=1.0
    ];
    engine [
      label=<<B>BOS Agent Engine</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Build, run and coordinate intelligent agents</FONT>>,
      fillcolor="#F2F2F2", color="#E8E8E8", width=8.6, height=1.0
    ];
    capabilities [
      label=<<B>Core Capabilities</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Models  ·  Tools  ·  Context  ·  Communication  ·  Trust</FONT>>,
      width=8.6, height=1.0
    ];
    foundation [
      label=<<B>Runtime Foundation</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Async Runtime  ·  Configuration  ·  Observability  ·  Storage</FONT>>,
      fillcolor="#F2F2F2", color="#E8E8E8", width=8.6, height=1.0
    ];
    ecosystem [
      label=<<B>Open Ecosystem</B><BR/><FONT POINT-SIZE="14" COLOR="#666666">Providers  ·  Integrations  ·  Extensions</FONT>>,
      fillcolor="#E8F3FA", color="#DDEBF4", width=8.6, height=1.0
    ];

    interfaces -> engine -> capabilities -> foundation -> ecosystem;
  }
}