{
  "description": "Press a key or chord, e.g. key=\"return\" or key=\"cmd+shift+t\".",
  "input_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string"
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "cmd",
            "shift",
            "ctrl",
            "alt",
            "fn"
          ]
        }
      }
    },
    "required": [
      "key"
    ],
    "additionalProperties": false
  },
  "capabilities": [
    "computer.use"
  ]
}
