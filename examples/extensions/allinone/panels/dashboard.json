            ],
            [
              "Configuration",
              "schemas/config.schema.json",
              "config tool"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Try it",
          "level": 3
        },
        {
          "type": "list",
          "items": [
            {
              "title": "Refresh this panel",
              "detail": "Dispatches the refresh command and returns revision 2.",
              "action": "refresh"
            },
            {
              "title": "Say hello",
              "detail": "Dispatches the hello command; the result is summarized under the panel.",
              "action": "hello"
            },
            {
              "title": "Read the event log",
              "detail": "Ask the agent to call events; the process records every subscribed topic."
            },
            {
              "title": "Run the workflow",
