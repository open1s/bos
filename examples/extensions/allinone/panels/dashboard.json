              "bsh ext mock … echo"
            ],
            [
              "Command",
              "commands/*.md",
              "Composer palette"
            ],
            [
              "Panel",
              "panels/dashboard.json",
              "This card"
            ],
            [
              "Prompt",
              "prompts/guide.md",
              "Agent instruction"
            ],
            [
              "Context",
              "contexts/workspace.md",
              "Only in matching workspaces"
            ],
            [
              "Skill",
              "skills/allinone/SKILL.md",
              "Agent skill list"
            ],
            [
              "Language",
              "languages/demo.json",
              "bsh ext languages"
            ],
            [
              "Integration",
              "integrations/*.json",
              "bsh ext integrations"
            ],
            [
              "Theme",
              "themes/aurora.json",
              "Settings → Extensions"
            ],
            [
              "Preset",
              "presets/safe.json",
              "Agent presets"
            ],
            [
              "Model provider",
              "providers/models/demo.json",
